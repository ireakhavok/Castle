classDiagram
    class MenuSystem {
        +HtmlElement Root
        +Update(deltaTime)
        +Render()
        +LoadMenu(file)
    }
    class HtmlElement {
        +string Tag
        +Dictionary~string,string~ Attributes
        +List~HtmlElement~ Children
        +CssStyle Style
        +AddChild(HtmlElement)
    }
    class ButtonElement {
        <<inherits HtmlElement>>
        +Action OnClick
    }
    class TextElement {
        <<inherits HtmlElement>>
        +string Content
    }
    class CssStyle {
        +Vector2 Position
        +Vector4 Color
        +float FontSize
    }
    class HtmlParser {
        +Parse(htmlString) HtmlElement
    }
    class CssParser {
        +Apply(cssString, HtmlElement root)
    }
    class JsHandler {
        +Evaluate(jsString, HtmlElement context)
    }
    class IControlContext {
        +SetMouseCallback(id, callback)
        +SetKeyCallback(id, callback)
        +Vector2 GetMousePosition()
    }
    class GlfwControlContext {
        <<implements IControlContext>>
        -Glfw _glfw
        -WindowHandle* _window
    }
    MenuSystem --> HtmlElement
    MenuSystem --> EventBus
    MenuSystem --> IRenderContext
    HtmlParser --> HtmlElement
    CssParser --> CssStyle
    HtmlElement --> CssStyle
    InputHandler --> IControlContext
    Launcher --> IControlContext
    Launcher --> MenuSystem