<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Game</AssemblyName>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\SiegeEngine\SiegeEngine.csproj" />
    <ProjectReference Include="..\Trebuchet\Trebuchet.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="$(NuGetPackageRoot)silk.net.glfw\2.22.0\runtimes\win-x64\native\glfw3.dll"
          Condition="Exists('$(NuGetPackageRoot)silk.net.glfw\2.22.0\runtimes\win-x64\native\glfw3.dll')"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          Link="glfw3.dll" />
  </ItemGroup>
</Project>
